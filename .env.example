# ─── TELEGRAM API CREDENTIALS ──────────────────────────────────────────────────
# Obtain from https://my.telegram.org
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Primary Pyrogram v2 User Session String (Generate with `python generate_session.py`)
SESSION_STRING=1BVts...

# ─── DATABASE CONFIGURATION ────────────────────────────────────────────────────
# Supabase / PostgreSQL Database Connection URI
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ─── LOGGING & ZERO-BYTE CLOUD CACHING ─────────────────────────────────────────
# Channel where downloaded files are mirrored for zero-byte cloud re-delivery (ID format: -100xxxxxxxxxx)
LOG_CHANNEL=-1001234567890

# Channel where download metadata and link audit logs are stored (ID format: -100xxxxxxxxxx)
LINK_LOG_CHANNEL=-1001234567890

# ─── ADMIN & SECURITY ─────────────────────────────────────────────────────────
# Comma-separated list of numeric Telegram User IDs with permanent Owner God Mode
OWNER_IDS=6870407493

# ─── SERVER KEEP-ALIVE ────────────────────────────────────────────────────────
# Health check port for Render/container deployment (defaults to 8080)
PORT=8080
